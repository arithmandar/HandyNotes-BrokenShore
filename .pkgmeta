package-as: HandyNotes_BrokenShore

manual-changelog:
    filename: Docs/ChangeLog.txt
    markup-type: plain
    
enable-nolib-creation: no

# configs for WowInterface
wowi-archive-previous: yes
wowi-create-changelog: no

externals:
    Libs/LibBabble-SubZone-3.0: 
        url: https://repos.curseforge.com/wow/libbabble-subzone-3-0/trunk
    Libs/LibUIDropDownMenu: 
        url: https://repos.curseforge.com/wow/libuidropdownmenu/trunk/LibUIDropDownMenu


ignore:
    - Images/PSD

